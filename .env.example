# Test Agents v3 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# LLM 配置
TEST_AGENTS_MODEL=kimi-k2.6
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1  # 国内模型基地址（可选）

# Claude CLI 配置
TEST_AGENTS_CLAUDE_TIMEOUT=1200
TEST_AGENTS_CLAUDE_RETRIES=1

# 业务知识库路径
TEST_AGENTS_KNOWLEDGE_DIR=

# v3 Plan-and-Solve + Reflection 配置
TEST_AGENTS_MAX_PLAN_ITERATIONS=1
TEST_AGENTS_MAX_CONFIRM_RETRIES=1
TEST_AGENTS_MAX_WORKER_REFLECTIONS=0
TEST_AGENTS_EXPERIENCE_FILE=
